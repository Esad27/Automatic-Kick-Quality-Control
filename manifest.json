{
  "manifest_version": 3,
  "name": "Kick Quality Control",
  "version": "0.2.0",
  "description": "Kick yayınlarında kaliteyi en yükseğe veya seçilen çözünürlüğe ayarlar; aç/kapat kontrolü sunar.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://kick.com/*", "https://www.kick.com/*"],
  "action": {
    "default_title": "Kick Quality Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*", "https://www.kick.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://kick.com/*", "https://www.kick.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
